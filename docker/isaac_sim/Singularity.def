Bootstrap: docker
From: nvcr.io/nvidia/isaac-sim:6.0.0

%post
    # Rootless OCI unpacking can preserve owner-only modes from the source
    # image. Rosie executes the SIF as the submitting user, so the launcher
    # and its parent tree must be readable/traversable by non-root users.
    chmod -R a+rX /isaac-sim
    find /isaac-sim -type f -name '*.sh' -exec chmod a+rx {} +
    chmod a+rx /isaac-sim/python.sh /isaac-sim/kit 2>/dev/null || true

%labels
    IsaacSimVersion 6.0.0
    PermissionFix rootless-rosie
